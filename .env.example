# Copy to .env and adjust. Every setting has a working default, so an empty
# .env still runs. Never commit the real .env — secrets live in the
# environment, never in the repo.

# Hostname this instance is served at. Used for the Traefik router rule.
CYOA_PUBLIC_HOST=cyoa.castaldifamily.com

# Shown in the header and page titles.
CYOA_SITE_NAME=CYOA

# Where stories are read from and progress is written. The container defaults
# are /app/stories and /app/data/cyoa.db; override only when running locally.
#CYOA_STORIES_DIR=stories
#CYOA_DB_PATH=data/cyoa.db

# DEBUG, INFO, WARNING, ERROR.
CYOA_LOG_LEVEL=INFO

# --- Roadmap ---------------------------------------------------------------
# Live LLM story generation is not implemented. When it is, the key is read
# from the environment here and the feature stays off unless one is present.
#ANTHROPIC_API_KEY=
